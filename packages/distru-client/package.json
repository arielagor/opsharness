{
  "name": "@opsharness/distru-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for a subset of Distru's public API, implementing the published contract: next_page pagination, bracketed array filters, inclusive datetime ranges, one error-envelope parser, Retry-After on 429.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@opsharness/distru-contract": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.26.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^5.0.3"
  }
}
