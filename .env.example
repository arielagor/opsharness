# opsharness environment. Every variable is optional: with none set, everything runs against the
# in-process mock of Distru's API with a scripted model and the local Postgres from docker-compose.yml.
# The code reads process.env directly; nothing loads this file. Export what you need in your shell.

# Postgres (Prisma tables + LangGraph checkpoints). Default matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5547/opsharness

# Live model (evals --live, harness --live). The model id is never hard-coded.
#   With ANTHROPIC_API_KEY: an Anthropic API model id.
#   With OPSHARNESS_LEAN_CLAUDE: a tier name (deep | standard | fast) for the CLI wrapper.
OPSHARNESS_MODEL=
ANTHROPIC_API_KEY=
# Path to a module exporting runClaude(prompt, opts) that shells out to the Claude Code CLI.
OPSHARNESS_LEAN_CLAUDE=

# Distru endpoint. Unset = in-process mock. To use the HTTP mock: pnpm --filter @opsharness/distru-mock start
# This project has only ever run against the mock.
DISTRU_BASE_URL=
# JSON map of tenant id to API token, e.g. {"tenant-a":"mock-token-tenant-a-full","tenant-b":"mock-token-tenant-b-full"}
DISTRU_TOKENS=
DISTRU_MOCK_PORT=4010

# MCP servers
MCP_DISTRU_PORT=4020
# stdio server: which SYNTHETIC demo principal it acts as
OPSHARNESS_PRINCIPAL=agent-erp@tenant-a

# Observability
OPSHARNESS_TRACE_FILE=.otel/traces.jsonl
OPSHARNESS_LOG_LEVEL=info

# Console: the principal the web console acts as (no login in this sample)
OPSHARNESS_CONSOLE_PRINCIPAL=human-approver@tenant-a
