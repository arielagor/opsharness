{
  "name": "@opsharness/harness",
  "version": "0.1.0",
  "private": true,
  "description": "LangGraph.js supervisor (intake, ERP, verifier) with a human approval interrupt and Postgres checkpoints. Runs against the Distru mock and SYNTHETIC fixtures.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opsharness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opentelemetry/api": "1.9.1",
    "@opsharness/core": "workspace:*",
    "@opsharness/db": "workspace:*",
    "@opsharness/distru-client": "workspace:*",
    "@opsharness/distru-mock": "workspace:*",
    "@opsharness/mcp-distru": "workspace:*",
    "@opsharness/mcp-workspace": "workspace:*",
    "@opsharness/telemetry": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.26.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^5.0.3"
  }
}
